{
  // Cloudflare Workers config. No secrets here: ANTHROPIC_API_KEY, ELEVENLABS_API_KEY,
  // ACCESS_PASSCODE and SESSION_SECRET are set as encrypted secrets in the dashboard.
  "name": "debate-arena",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Only ./src is uploaded as static files; every request runs the Worker first.
  "assets": { "directory": "./src", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "CAP", "class_name": "DailyCap" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyCap"] }],
  // Workers Logs (dashboard: Workers → debate-arena → Logs).
  "observability": { "enabled": true },
  // Debates per UTC day. Edit here (a deploy resets dashboard-edited plain vars to this value).
  "vars": { "DAILY_CAP": "20" }
}
